<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_master_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_master_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MASTER VITALS MATRIX"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELLNEST"
            android:textColor="#8010B981"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- 4-Quadrant Vitals Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- Pulse -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_subcard_pulse"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PULSE"
                android:textColor="#EF4444"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_master_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="74"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPM"
                android:textColor="#B0EF4444"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Water -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_subcard_water"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WATER"
                android:textColor="#2EB5FA"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_master_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.8L"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOAL"
                android:textColor="#B02EB5FA"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Steps -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_subcard_steps"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEPS"
                android:textColor="#FF9442"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_master_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8.4k"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="84%"
                android:textColor="#B0FF9442"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sleep -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_subcard_sleep"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLEEP"
                android:textColor="#818CF8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_master_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.8h"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92%"
                android:textColor="#B0818CF8"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="● Continuous Sensor Fusion • 88% Vitality Index"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
